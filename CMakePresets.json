{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Release (Ninja, MSVC)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [{ "name": "default", "configurePreset": "default" }],
  "testPresets": [
    { "name": "default", "configurePreset": "default", "output": { "outputOnFailure": true } }
  ],
  "packagePresets": [{ "name": "default", "configurePreset": "default" }],
  "workflowPresets": [
    {
      "name": "default",
      "steps": [
        { "type": "configure", "name": "default" },
        { "type": "build", "name": "default" },
        { "type": "test", "name": "default" },
        { "type": "package", "name": "default" }
      ]
    }
  ]
}
